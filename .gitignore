# References
# https://git-scm.com/docs/gitignore
# https://github.com/github/gitignore/blob/master/Python.gitignore

# _____________________________________________________________________________
# Generated files
*.bak
*.bak.*
*.backup
*.bkp
*.log
*.tmp
*.*~
*.*#
.*
!.gitignore
!.aiignore

# Archive files
*.7z
*.bz2
*.gz
*.gzip
*.rar
*.tar
*.tgz
*.zip

# Project paths
archive/
build/
cache/
dist/
downloads/
logs/

# Project output paths
out/
output/
**/temp/
**/tmp/
**/backup/

# Project data paths / files
*.sqlite
*.db
*.duckdb
data*/
input/

# _____________________________________________________________________________
# Tools
# IDEs paths / files
*.code-workspace
*.swp
*.swo
.idea/
.vscode/
.DS_Store
.project
.pydevproject
.settings/

# Testing and coverage
*.cover
.cache
.coverage
.pytest_cache/
.tox/
htmlcov/
.mypy_cache/
.ruff_cache/
.nox/

# - Python byte-compiled / optimized / DLL files
*.py[cod]
*$py.class
*.so
**/__pycache__/

# - Python Environments
.env/
env/
.venv/
venv/
ENV/
env.bak/
venv.bak/